            "effect": "Allow",
            "actions": [
              "xray:PutTraceSegments",
              "xray:PutTelemetryRecords",
              "xray:GetSamplingRules",
              "xray:GetSamplingTargets",
              "xray:GetSamplingStatisticSummaries"
            ],
            "resources": [
              "*"
            ]
          },
          {
            "policy": "AWSLambdaBasicExecutionRole",
            "effect": "Allow",
            "actions": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "resources": [
              "*"
            ]
          }
        ]
      }
    }
  }
}
